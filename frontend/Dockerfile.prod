FROM node:22 AS build
WORKDIR /app

# Playwright is a devDependency used only for local bug repro/manual browser
# driving — never actually run in this build. Skip its ~300MB browser download
# here; `npm ci` still installs the JS package (harmless, and needed for the
# lockfile to resolve), it just won't fetch Chromium/Firefox/WebKit binaries.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

ARG BACKEND_ORIGIN=https://api.swc-joe.com

COPY nginx.conf /etc/nginx/conf.d/default.conf.template
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html

# Substitute BACKEND_ORIGIN_PLACEHOLDER in nginx config at build time
RUN sed "s|BACKEND_ORIGIN_PLACEHOLDER|${BACKEND_ORIGIN}|g" \
      /etc/nginx/conf.d/default.conf.template \
      > /etc/nginx/conf.d/default.conf \
    && rm /etc/nginx/conf.d/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
