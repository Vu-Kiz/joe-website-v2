VITE_BACKEND_ORIGIN=https://api.example.com
VITE_API_BASE_URL=https://api.example.com/api
VITE_ALLOWED_HOSTS=frontend.example.com,127.0.0.1,localhost

# --- GlitchTip (error monitoring) ---
# DSN from GlitchTip dashboard after creating a project
VITE_GLITCHTIP_DSN=
# Routes errors through your own domain to bypass adblockers
# Prod: https://www.swc-joe.com/errors
# Dev:  https://dev-v2.swc-joe.com/errors
VITE_GLITCHTIP_TUNNEL=

# --- OpenReplay (session replay) ---
# Project key from OpenReplay dashboard after creating a project
VITE_OPENREPLAY_KEY=
# Routes sessions through your own domain to bypass adblockers
# Prod: https://www.swc-joe.com/ingest
# Dev:  https://dev-v2.swc-joe.com/ingest
VITE_OPENREPLAY_INGEST_URL=
