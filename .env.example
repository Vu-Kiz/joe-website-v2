# =========================
# Repo Root / Docker Compose
# =========================

# Project naming
COMPOSE_PROJECT_NAME=joe-website-v2-dev
GIT_BRANCH=dev

# Public app URL used by compose-backed services
APP_URL=https://frontend.example.com

# =========================
# Database (MariaDB container)
# =========================
DB_ROOT_PASSWORD=change-me
DB_DATABASE=joe_v2_dev
DB_USERNAME=joe
DB_PASSWORD=change-me

# =========================
# Scout / Meilisearch (Prod)
# =========================
SCOUT_PREFIX=joe_v2_prod_
MEILISEARCH_KEY=change-me

# =========================
# GlitchTip
# =========================
GLITCHTIP_DB_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_hex(50))"
GLITCHTIP_SECRET_KEY=change-me
# smtp+tls://user:password@smtp.example.com:587 or console:// for local testing
GLITCHTIP_EMAIL_URL=console://
GLITCHTIP_FROM_EMAIL=change@me.please
