# =========================
# Repo Root / Docker Compose
# =========================

# Project naming
COMPOSE_PROJECT_NAME=joe-website-v2-dev
GIT_BRANCH=dev

# Public app URL used by compose-backed services
APP_URL=https://frontend.example.com

# =========================
# Database (MariaDB container)
# =========================
DB_ROOT_PASSWORD=change-me
DB_DATABASE=joe_v2_dev
DB_USERNAME=joe
DB_PASSWORD=change-me

# =========================
# Scout / Meilisearch (Prod)
# =========================
SCOUT_PREFIX=joe_v2_prod_
MEILISEARCH_KEY=change-me
