# backend/Dockerfile.dev
FROM php:8.4-apache

# System dependencies + PHP extensions for Laravel
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libonig-dev \
    libicu-dev \
  && docker-php-ext-install pdo pdo_mysql mbstring zip intl \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Enable mod_rewrite
RUN a2enmod rewrite

# Use our Laravel vhost config
COPY apache/000-default.conf /etc/apache2/sites-available/000-default.conf

# Work in Laravel app root
WORKDIR /var/www/html

# Copy backend source into the image
COPY . /var/www/html

# Install Composer into the image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install PHP dependencies
RUN composer install --no-interaction --prefer-dist --no-progress
