APP_NAME="Jawa Offworld Enterprises"
APP_ENV=local
APP_KEY=base64:generate-me-with-artisan-key-generate
APP_DEBUG=true
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- DB ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=joe_v2_dev
DB_USERNAME=joe
DB_PASSWORD=change-me

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=joe_v2_dev_session

# --- Sanctum / CORS ---
SANCTUM_STATEFUL_DOMAINS=frontend.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://frontend.example.com
CORS_SUPPORTS_CREDENTIALS=true

# --- SWC OAuth ---
SWC_OAUTH_AUTHORIZE_URL="https://www.swcombine.com/ws/oauth2/auth/"
SWC_OAUTH_TOKEN_URL="https://www.swcombine.com/ws/oauth2/token/"
SWC_OAUTH_API_BASE="https://www.swcombine.com/ws/v2.0"
SWC_OAUTH_DEFAULT_SCOPE="character_read"
SWC_OAUTH_ACCESS_TYPE="online"
SWC_OAUTH_EVENTS_SCOPE="character_events"
SWC_OAUTH_EVENTS_ACCESS_TYPE=offline
SWC_OAUTH_DEBUG_SCOPE="character_all faction_all messages_all"
SWC_OAUTH_DEBUG_ACCESS_TYPE=offline
SWC_OAUTH_CLIENT_ID=change-me
SWC_OAUTH_CLIENT_SECRET=change-me
SWC_OAUTH_REDIRECT_URI="https://api.example.com/oauth/callback"
SWC_FRONTEND_URL="https://frontend.example.com"
SWC_HTTP_USER_AGENT="JOE v2 Backend (contact: admin@example.com)"

# --- Discord OAuth ---
DISCORD_CLIENT_ID=change-me
DISCORD_CLIENT_SECRET=change-me
DISCORD_REDIRECT_URI="https://api.example.com/auth/discord/callback"
DISCORD_FRONTEND_URL="https://frontend.example.com"

# --- Optional integrations ---
JOBS_DISCORD_WEBHOOK_URL=
JOBS_DISCORD_FRONTEND_URL="https://frontend.example.com"
JOBS_DISCORD_ASSET_URL="https://api.example.com"
DISCORD_BOT_SHARED_TOKEN=change-me
DISCORD_BOT_CLIENT_ID=
DISCORD_BOT_INVITE_PERMISSIONS=0
DISCORD_BOT_INVITE_SCOPES="bot applications.commands"
